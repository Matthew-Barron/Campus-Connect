# Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser-safe Supabase key. This is safe to expose to the browser when RLS is configured.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secret. NEVER put this in frontend code or expose it publicly.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Express server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# Supabase password-recovery redirect. Add this exact URL to
# Supabase Dashboard -> Authentication -> URL Configuration -> Redirect URLs.
PASSWORD_RESET_REDIRECT_URL=http://localhost:5000/
